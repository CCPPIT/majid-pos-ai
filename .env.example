# ─────────────────────────────────────────────────────────────
# MAJID POS AI — Environment variables
# All runtime env vars MUST be prefixed with EXPO_PUBLIC_ and
# declared/validated in src/core/config/env.ts
# Copy to .env and adjust as needed.
# ─────────────────────────────────────────────────────────────

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Backend API (not used in PHASE 01 — repositories are local/mock until wired)
EXPO_PUBLIC_API_BASE_URL=

# AI service endpoint (wired in PHASE 24/25)
EXPO_PUBLIC_AI_BASE_URL=

# Localization
EXPO_PUBLIC_DEFAULT_LOCALE=ar
EXPO_PUBLIC_DEFAULT_CURRENCY=YER

# Feature flags
EXPO_PUBLIC_ENABLE_OFFLINE_SYNC=true
EXPO_PUBLIC_ENABLE_AI=false
